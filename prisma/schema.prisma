// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  RENT
  SALE
}


model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  password        String?
  profilePicture  String?   @map("profile_picture")
  createdAt       DateTime  @default(now()) @map("created_at")

  listings  Listing[]
  bookings  Booking[]
  ratings   Rating[]

  @@map("users")
}

model Listing {
  id               String      @id @default(uuid())
  name             String
  url              String      @unique
  propertyType     String      @map("property_type")
  description      String?
  price            Float     
  priceCurrency    String      @map("price_currency")
  listingType      ListingType @map("listing_type")
  images           String[]
  country          String
  area             String
  latitude         Float
  longitude        Float
  cityId           String      @map("city_id")           // ✅ fixed from listing_id
  listingDetailsId String?     @map("listing_details_id") // ✅ fixed missing quote, made optional
  userId           String      @map("user_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id])
  city           City           @relation(fields: [cityId], references: [id])
  listingDetails ListingDetails? @relation(fields: [listingDetailsId], references: [id])
  ratings        Rating[]
  bookings       Booking[]

  @@map("listings")
}

model ListingDetails {
  id             String  @id @default(uuid())
  guests         Int
  bedrooms       Int
  beds           Int
  baths          Int
  airConditioned Int     @map("air_conditioned")
  swimmingPool   Int     @map("swimming_pool")
  gym            Int
  parking        Int
  golf           Int
  spa            Int
  wifi           Int
  others         String?

  listings Listing[]

  @@map("listing_details")
}

model Rating {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("ratings")
}

model Booking {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model City {
  id       String    @id @default(uuid())
  name     String    @unique
  icon     String
  listings Listing[]

  @@map("cities")
}